CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
# PSRAM clock: 40 MHz, deliberately and explicitly.
#
# This is the clock every artifact in benchmarks/results/ was measured on, and it
# is also what a plain defaults file produces, so stating it costs nothing.
#
# This line previously read CONFIG_SPIRAM_SPEED_80M=y, which never took effect.
# In esp_psram/esp32/Kconfig.spiram the symbol carries
#     depends on ESPTOOLPY_FLASHFREQ_80M
# and flash frequency is left at its 40M default here (only ESPTOOLPY_FLASHSIZE_4MB
# is set above, which is capacity, not speed). The dependency is unmet, kconfgen
# discards the value, and - the dangerous part - it does so *silently*: no warning
# is printed, so the file used to claim a configuration the firmware never ran at.
#
# Verified empirically 2026-09-29 (ADR-0015): a clean checkout configures to
# CONFIG_SPIRAM_SPEED_40M=y, matching the measured build exactly. Changing this to
# 80 MHz means also raising ESPTOOLPY_FLASHFREQ to 80M, which is a new, unmeasured
# configuration affecting frame-buffer bandwidth. Read ADR-0015 first.
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_TCP_FIN_WAIT_TIMEOUT=5000
CONFIG_CAMERA_JPEG_MODE_FRAME_SIZE_CUSTOM=y
CONFIG_CAMERA_JPEG_MODE_FRAME_SIZE=262144

# ---------------------------------------------------------------------------
# Wi-Fi / TCP throughput tuning (ADR-0018)
#
# STATUS: UNMEASURED. Every line below is a candidate, not a result. The
# baseline (before this block) is git commit 5f1ef41; ADR-0018 holds the A/B
# protocol and the revert rule. ADR-0010 decision 6 recorded that the link was
# not the binding constraint at the time (peak 4.36 Mbps observed); this block
# re-opens that question at the project owner's request and must be judged by
# measurement, not by the generic throughput figures that motivated it.
#
# Reminder (ADR-0015): sdkconfig.defaults only supplies symbols that are NOT
# already in the generated, git-ignored sdkconfig. A machine that already has an
# sdkconfig keeps its old values until it is deleted and regenerated
# (idf.py fullclean; delete sdkconfig; idf.py set-target esp32). Verify with
# `grep` on the generated sdkconfig, never by reading this file.
# ---------------------------------------------------------------------------

# 1. CPU at maximum. ESP32 default is 160 MHz (Kconfig.cpu), so this is a real
#    change. Higher CPU clock raises supply current: the record already holds
#    brownout resets under heavy streaming (benchmark-results.md, Phase 4).
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# 2. Flash QIO @ 80 MHz. Both are real changes (defaults are DIO / 40 MHz).
#    ESPTOOLPY_FLASHFREQ_80M is also the precondition that makes
#    SPIRAM_SPEED_80M selectable, so PSRAM is pinned to 40 MHz explicitly
#    further up. "Flash 80 / PSRAM 40" is combination 2 of the three that
#    Kconfig.spiram documents as supported. PSRAM 80 MHz stays a separate,
#    unadopted lever (ADR-0015 decision 5).
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# 3. TCP windows: 32 KiB, the low end of the 32-65 KiB range. Defaults are
#    5760 (4 x MSS). Allowed range without window scaling is 2440..65535.
#    These buffers are carved from internal RAM, which is scarce next to the
#    PSRAM frame buffers; raise further only after reading free internal RAM
#    (status free_heap - free_spiram) under HD load.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_WND_DEFAULT=32768

# 4. Wi-Fi dynamic buffers: 64 each (defaults 32 / 32; range 1..128 TX, 0..128
#    RX). 64/64 is also what Espressif's own iperf example uses for ESP32.
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64

# 5. IRAM placement of the hot Wi-Fi / TCP-IP paths.
#    ESP_WIFI_IRAM_OPT and ESP_WIFI_RX_IRAM_OPT already default to y on this
#    configuration (esp_wifi/Kconfig: only default n when Bluetooth + PSRAM are
#    enabled, and Bluetooth is not), so those two lines pin an existing
#    behaviour and change nothing. LWIP_IRAM_OPTIMIZATION defaults to n, so it
#    is the real change in this group (about 10 KB of IRAM).
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y
CONFIG_LWIP_IRAM_OPTIMIZATION=y

# 6. Keep Wi-Fi / lwIP allocations in internal RAM, never PSRAM. This is the
#    default; stated so that nobody turns it on believing it saves internal RAM
#    at no cost to throughput. Frame buffers stay in PSRAM by the camera
#    driver's own choice (app.h CAM_DEFAULT_FB_LOCATION).
# CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP is not set
